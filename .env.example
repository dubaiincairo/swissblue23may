# Keep both flags false until every server-side safeguard below is configured.
NEXT_PUBLIC_AI_CHAT_ENABLED=false
AI_CHAT_ENABLED=false

# Create a project-scoped OpenAI API key. Never expose this value with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Routine questions stay on the fast, cost-efficient model. Complex follow-ups,
# complaints, recommendations, and human handoffs use the advanced model.
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_CHAT_ADVANCED_MODEL=gpt-5.1

# Required. The assistant fails closed if the shared Upstash limiter is missing or unavailable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hard request caps. These have conservative defaults even when omitted.
OPENAI_CHAT_IP_PER_MINUTE=3
OPENAI_CHAT_IP_PER_DAY=20
# Keep below the current OpenAI project RPM allowance to absorb short bursts gracefully.
OPENAI_CHAT_SITE_PER_MINUTE=8
OPENAI_CHAT_DAILY_LIMIT=400
OPENAI_CHAT_MONTHLY_LIMIT=6000

# Optional: an OpenAI vector store containing approved PDFs, Word files, or other documents.
# Leave blank until documents are uploaded and reviewed.
OPENAI_VECTOR_STORE_ID=

# Optional Google Analytics 4 integration. The public measurement ID is loaded
# only after a visitor accepts analytics cookies. The remaining values are used
# only by the protected admin Overview reporting API.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
# One-line JSON for a Google service account with Viewer access to the GA4 property.
GOOGLE_ANALYTICS_SERVICE_ACCOUNT_JSON=
# Set to true after creating GA4 custom event dimensions for property_slug and locale.
GA4_PROPERTY_CUSTOM_DIMENSIONS_READY=false

# Chat leads are saved in Sanity and use the existing Brevo email settings.
# Configure SANITY_FORMS_TOKEN (or SANITY_API_WRITE_TOKEN), BREVO_API_KEY, and BREVO_FROM_EMAIL separately.
